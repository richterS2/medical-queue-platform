<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".WebPrintActivity"

    android:id="@+id/butonLayoutChield"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:paddingBottom="20dp">

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <Button
            android:id="@+id/btn1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clinico_geral"
            android:gravity="center"

            android:textColor="@color/white"
            android:textSize="14sp"
            android:background="@drawable/btn_background_blue"
            android:padding="10dp"
            />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="0.4"
        android:gravity="center"
        >

        <info.androidhive.fontawesome.FontTextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="@string/fa_smile_beam"
            android:textColor="@color/black"
            android:textSize="25sp"
            app:solid_icon="true"
            android:gravity="center"
            />

    </RelativeLayout>

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <Button
            android:id="@+id/btn2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clinico_geral"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:background="@drawable/btn_background_red"
            android:padding="10dp"
            />
    </RelativeLayout>

</LinearLayout>
